{
  "name": "zipcalm",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "vite --config web/vite.config.js",
    "build": "node scripts/check-drift.js && vite build --config web/vite.config.js",
    "preview": "vite preview --config web/vite.config.js",
    "start": "node server/boot.js",
    "check:drift": "node scripts/check-drift.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.6",
    "archiver": "^7.0.1",
    "archiver-zip-encrypted": "^2.0.0",
    "axios": "^1",
    "dayjs": "^1",
    "fastify": "^5.12.7",
    "js7z-tools": "2.5.0",
    "lucide-vue-next": "^1.0.0",
    "node-unrar-js": "2.0.2",
    "pinia": "^2",
    "pretty-bytes": "^6",
    "tar": "^7.5.1",
    "unzipper": "^0.12.3",
    "uplot": "^1.6.32",
    "vue": "^3",
    "vue-router": "^4"
  },
  "devDependencies": {
    "vite": "^5",
    "@vitejs/plugin-vue": "^5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EIGHTfs/ZipCalm.git"
  },
  "license": "MIT",
  "author": "EIGHTfs",
  "keywords": [
    "nas",
    "compression",
    "zip",
    "tar",
    "zstd",
    "synology",
    "self-hosted"
  ]
}
