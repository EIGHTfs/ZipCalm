{
  "name": "zipcalm",
  "version": "1.0.1",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "vite --config web/vite.config.js",
    "build": "node scripts/check-drift.js && vite build --config web/vite.config.js",
    "preview": "vite preview --config web/vite.config.js",
    "start": "node server/boot.js",
    "check:drift": "node scripts/check-drift.js"
  },
  "bin": {
    "zipcalm": "bin/zipcalm.js"
  },
  "files": [
    "bin/",
    "server/",
    "shared/",
    "web/dist/",
    "README.md",
    "LICENSE"
  ],
  "prepublishOnly": "npm run build",
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.6",
    "archiver": "^7.0.1",
    "archiver-zip-encrypted": "^2.0.0",
    "axios": "1.20.0",
    "dayjs": "1.11.23",
    "fastify": "^5.12.7",
    "js7z-tools": "2.5.0",
    "lucide-vue-next": "^1.0.0",
    "node-unrar-js": "2.0.2",
    "pinia": "2.3.1",
    "pretty-bytes": "6.1.0",
    "tar": "^7.5.1",
    "unzipper": "0.12.5",
    "uplot": "^1.6.32",
    "vue": "3.5.44",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "vite": "^5",
    "@vitejs/plugin-vue": "^5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EIGHTfs/ZipCalm.git"
  },
  "license": "MIT",
  "author": "EIGHTfs",
  "keywords": [
    "nas",
    "compression",
    "zip",
    "tar",
    "zstd",
    "synology",
    "self-hosted"
  ]
}
